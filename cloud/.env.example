# AutoSEO Cloud — the only environment variables the app reads.
# Stripe, Coolify and SMTP credentials are entered in /admin and stored encrypted (key: DATA_DIR/secret.key).

# Public host of the cloud dashboard (links in emails, Stripe URLs, cookies).
DOMAIN=autoseo.codext.de
# Optional full URL override, e.g. for local development: APP_URL=http://localhost:3200
# APP_URL=

# PostgreSQL connection (docker-compose.yml sets this for you).
DATABASE_URL=postgres://cloud:change-me@localhost:5432/cloud

# Persistent data dir. Holds secret.key, the encryption key for stored credentials — keep it on a volume and back it up.
DATA_DIR=./data

# Comma-separated emails that get access to /admin.
ADMIN_EMAILS=you@example.com
