# AutoSEO — self-hosted Docker Compose config.
# Copy to .env and fill in the two required values. Everything else (email, AI providers, DataForSEO,
# Google OAuth, …) is configured afterwards in the admin panel — see docs/SELF_HOSTING.md.
# `deploy/install.sh` generates this file for you.

### Required ###

# Public domain this instance is served on, e.g. seo.example.com (no https://, no trailing slash, no port).
DOMAIN=

# Postgres password. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

### Optional ###

# Image tag to run. "latest" tracks the newest release; pin to a specific tag (e.g. v1.4.0) for stability.
AUTOSEO_VERSION=latest

# Reverse proxy. "proxy" runs the bundled Caddy service (automatic HTTPS on 80/443 for DOMAIN).
# Already have your own reverse proxy (Traefik, nginx, Cloudflare Tunnel, …)? Set this empty — the app
# is then only reachable at 127.0.0.1:${APP_PORT:-3000} for your proxy to target.
COMPOSE_PROFILES=proxy

# Port the app binds to on 127.0.0.1 — used directly when COMPOSE_PROFILES is empty, and internally by
# Caddy otherwise. Rarely needs changing.
#APP_PORT=3000

# Bootstrap settings — skip the /setup wizard and/or set a default mail server. All optional; see
# docs/MANAGED_INSTANCES.md for the full list and docs/SELF_HOSTING.md for how they apply here.
#AUTOSEO_OWNER_EMAIL=
#AUTOSEO_OWNER_NAME=
#AUTOSEO_WORKSPACE_NAME=
#AUTOSEO_SMTP_URL=
#AUTOSEO_MAIL_FROM=
